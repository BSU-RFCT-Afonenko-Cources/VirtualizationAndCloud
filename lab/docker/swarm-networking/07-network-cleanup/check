#!/usr/bin/env bash
set -euo pipefail
source /opt/swarm-networking-lab/lib.sh

for service_name in edge api db; do
    ! service_exists "$service_name" || fail "service $service_name still exists"
done
[ -z "$(docker service ls --filter label=course.lab=swarm-networking --format '{{.Name}}')" ] || fail "labeled lab services still exist"
for network_name in lab-front lab-back; do
    ! network_exists "$network_name" || fail "network $network_name still exists"
done
[ -z "$(docker network ls --filter scope=swarm --format '{{.Name}}' | awk '/^lab-/')" ] || fail "lab-* swarm networks still exist"
printf 'OK: lab services were removed before lab overlay networks.\n'
