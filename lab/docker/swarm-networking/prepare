cat > /opt/swarm-networking-lab/lib.sh <<'LIB'
#!/usr/bin/env bash
set -euo pipefail

readonly LAB_HOME=/home/ubuntu/swarm-networking
readonly LAB_LABEL=course.lab=swarm-networking
readonly MARKER=overlay-db-ok

fail() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 1
}

service_exists() {
    docker service inspect "$1" >/dev/null 2>&1
}

network_exists() {
    docker network inspect "$1" >/dev/null 2>&1
}

service_container() {
    docker ps --filter "label=com.docker.swarm.service.name=$1" --format '{{.ID}}' | head -n 1
}

wait_service() {
    local service_name=$1
    local attempt
    for attempt in $(seq 1 60); do
        if [ "$(docker service inspect --format '{{if .UpdateStatus}}{{.UpdateStatus.State}}{{else}}none{{end}}' "$service_name" 2>/dev/null || true)" = "rollback_paused" ]; then
            fail "service $service_name rollback paused"
        fi
        if [ "$(docker service ps --filter desired-state=running --format '{{.CurrentState}}' "$service_name" 2>/dev/null | grep -c '^Running' || true)" -ge 1 ]; then
            return 0
        fi
        sleep 1
    done
    docker service ps --no-trunc "$service_name" >&2 || true
    fail "service $service_name did not reach Running state"
}

wait_healthy() {
    local service_name=$1
    local container_id
    local health
    local attempt
    for attempt in $(seq 1 60); do
        container_id=$(service_container "$service_name")
        if [ -n "$container_id" ]; then
            health=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$container_id")
            if [ "$health" = "healthy" ]; then
                return 0
            fi
        fi
        sleep 1
    done
    [ -n "${container_id:-}" ] && docker inspect "$container_id" >&2 || true
    fail "service $service_name did not become healthy"
}

assert_service_network() {
    local service_name=$1
    local network_name=$2
    docker service inspect --format '{{range .Spec.TaskTemplate.Networks}}{{println .Target}}{{end}}' "$service_name" |
        while read -r network_id; do
            [ -n "$network_id" ] && docker network inspect --format '{{.Name}}' "$network_id"
        done | grep -Fxq "$network_name" || fail "$service_name is not attached to $network_name"
}
LIB
chmod 0755 /opt/swarm-networking-lab/lib.sh

if [ "$(docker info --format '{{.Swarm.LocalNodeState}}')" = "inactive" ]; then
    docker swarm init --advertise-addr 127.0.0.1 >/dev/null
fi
[ "$(docker info --format '{{.Swarm.ControlAvailable}}')" = "true" ] || {
    printf 'Docker Swarm manager is required.\n' >&2
    exit 1
}

docker image inspect swarm-lab-api:1.0 >/dev/null 2>&1 || docker build -t swarm-lab-api:1.0 "$API_CONTEXT"
docker image inspect swarm-lab-edge:1.0 >/dev/null 2>&1 || docker build -t swarm-lab-edge:1.0 "$EDGE_CONTEXT"
docker image inspect redis:7-alpine >/dev/null 2>&1 || docker pull redis:7-alpine
chown -R ubuntu:ubuntu "$LAB_HOME"
