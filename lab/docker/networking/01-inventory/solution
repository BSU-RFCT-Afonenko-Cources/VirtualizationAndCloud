#!/bin/bash
set -euo pipefail
docker rm -f net-api net-client net-client-dns-fail net-proxy >/dev/null 2>&1 || true
docker network rm lab-net frontend backend >/dev/null 2>&1 || true
docker network ls > /home/ubuntu/lab/docker/networking/evidence/networks-initial.txt
docker network create --driver bridge --label course.lab=docker-networking --label course.role=shared lab-net >/dev/null
chown ubuntu:ubuntu /home/ubuntu/lab/docker/networking/evidence/networks-initial.txt
