#!/bin/bash
set -euo pipefail
docker rm -f net-proxy >/dev/null 2>&1 || true
docker run -d --name net-proxy --network lab-net --label course.lab=docker-networking --label course.role=proxy -e TARGET_HOST=net-api -e TARGET_PORT=8080 -p 127.0.0.1:18080:8080 course/net-proxy:1.0 >/dev/null
for _ in $(seq 1 30); do
  [ "$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' net-proxy 2>/dev/null)" = healthy ] && exit 0
  sleep 1
done
echo "net-proxy не стал healthy" >&2
exit 1
