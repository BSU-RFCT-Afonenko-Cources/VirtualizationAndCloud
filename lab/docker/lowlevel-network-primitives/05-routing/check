#!/usr/bin/env bash
set -euo pipefail
EVIDENCE=/home/ubuntu/netlab/evidence
mkdir -p "$EVIDENCE" /home/ubuntu/netlab/run
fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }
pass() { printf 'PASS: %s\n' "$*"; }
json_valid() { jq -e . "$1" >/dev/null 2>&1 || fail "invalid or missing evidence: $1"; }
ns_exists() { ip netns list | awk '{print $1}' | grep -Fxq "$1"; }
f="$EVIDENCE/05-routing.json"; json_valid "$f"
for ns in net-api-ns net-client-ns; do ip -n "$ns" -j route show default | jq -e '.[0].gateway=="10.203.0.1"' >/dev/null || fail "$ns default route"; done
for svc in api client; do pid=$(cat /home/ubuntu/netlab/run/$svc.pid); kill -0 "$pid" || fail "$svc process"; test "$(stat -Lc %i /proc/$pid/ns/net)" != "$(stat -Lc %i /proc/1/ns/net)" || fail "$svc is in host netns"; done
ip netns exec net-client-ns curl --noproxy '*' -fsS --max-time 3 http://10.203.0.10:8080/health | jq -e '.service=="net-api" and .namespace=="net-api-ns"' >/dev/null || fail "client HTTP request"
pass "routes and namespace HTTP workloads are active"
