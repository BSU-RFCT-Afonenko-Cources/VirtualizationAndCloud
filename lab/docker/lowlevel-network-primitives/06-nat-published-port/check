#!/usr/bin/env bash
set -euo pipefail
EVIDENCE=/home/ubuntu/netlab/evidence
mkdir -p "$EVIDENCE" /home/ubuntu/netlab/run
fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }
pass() { printf 'PASS: %s\n' "$*"; }
json_valid() { jq -e . "$1" >/dev/null 2>&1 || fail "invalid or missing evidence: $1"; }
ns_exists() { ip netns list | awk '{print $1}' | grep -Fxq "$1"; }
f="$EVIDENCE/06-nat.json"; json_valid "$f"
iptables -t nat -C OUTPUT -p tcp -d 10.203.0.1 --dport 18080 -m comment --comment netlab-published -j DNAT --to-destination 10.203.0.10:8080 2>/dev/null || fail "DNAT rule"
curl --noproxy '*' -fsS --max-time 3 http://10.203.0.1:18080/health | jq -e '.service=="net-api" and .namespace=="net-api-ns"' >/dev/null || fail "published endpoint"
pass "host published endpoint reaches namespace API through DNAT"
