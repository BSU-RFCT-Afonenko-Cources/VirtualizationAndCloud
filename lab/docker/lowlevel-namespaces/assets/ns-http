#!/usr/bin/python3
import argparse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json, os, socket
p=argparse.ArgumentParser(); p.add_argument('--bind',default='127.0.0.1'); p.add_argument('--port',type=int,default=8080); a=p.parse_args()
class H(BaseHTTPRequestHandler):
    def do_GET(self):
        body=json.dumps({'service':'ns-http','pid':os.getpid(),'hostname':socket.gethostname(),'path':self.path}).encode()
        self.send_response(200); self.send_header('Content-Type','application/json'); self.send_header('Content-Length',str(len(body))); self.end_headers(); self.wfile.write(body)
    def log_message(self,*args): pass
ThreadingHTTPServer((a.bind,a.port),H).serve_forever()
