[Unit]
Description=Capstone SQLite HTTP database
After=network-online.target home-ubuntu-capstone-07\x2ddatabase-data.mount
Wants=network-online.target
[Service]
Environment=CAP_DB_PATH=/home/ubuntu/capstone/07-database/data/orders.sqlite3
ExecStart=/usr/bin/python3 /home/ubuntu/capstone/07-database/db_service.py
Restart=on-failure
[Install]
WantedBy=multi-user.target
